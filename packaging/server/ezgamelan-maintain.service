[Unit]
Description=EZGameLAN revocation recovery and CRL renewal
ConditionPathExists=/etc/ezgamelan/config.json

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ezlanctl maintain
TimeoutStartSec=60s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ezgamelan /etc/ezgamelan/pki
CapabilityBoundingSet=
