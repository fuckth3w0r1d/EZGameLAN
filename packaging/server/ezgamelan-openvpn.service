[Unit]
Description=EZGameLAN OpenVPN server
Documentation=https://github.com/r3t2/ezgamelan
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/ezgamelan/server.conf

[Service]
Type=simple
ExecStart=/usr/sbin/openvpn --config /etc/ezgamelan/server.conf
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
KillSignal=SIGTERM
UMask=0077
RuntimeDirectory=ezgamelan
RuntimeDirectoryMode=0700

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/ezgamelan /run/ezgamelan
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
